# Copy to .env and adjust. Every task reads it, so a port set here applies to
# `task run`, `task demo` and the compose stack alike.
#
#   cp .env.example .env
#
# Defaults are the ones in the Taskfile: 8080, 8081, 6379, 8082, 8084, 8085.

# zaehlwerk-api. 8080 is a popular port; move it if something else has it.
# ZW_PORT=8090

# The led-catcher web simulator.
# ZW_SIMULATOR_PORT=8081

# Redis, as published on the host.
# ZW_REDIS_PORT=6380

# The fake Schmetterpause of `task chain:schmetterpause`.
# ZW_SCHMETTERPAUSE_PORT=8083

# The buttons page of `task chain:buttons`.
# ZW_BUTTONS_PORT=8085

# The piezo board's control endpoint, which the buttons page drives.
# ZW_PIEZO_CONTROL_PORT=8086
