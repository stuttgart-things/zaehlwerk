# Copy to .env and adjust. Every task reads it, so a port set here applies to
# `task run`, `task demo` and the compose stack alike.
#
#   cp .env.example .env
#
# Defaults are the ones in the Taskfile: 8080, 8081, 6379.

# zaehlwerk-api. 8080 is a popular port; move it if something else has it.
# ZW_PORT=8090

# The led-catcher web simulator.
# ZW_SIMULATOR_PORT=8081

# Redis, as published on the host.
# ZW_REDIS_PORT=6380
